{
  "name": "perigee-web",
  "private": true,
  "description": "Perigee browser app: globe, close approaches, shell risk, breakup simulator.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../tests/fixtures/openapi.json -o src/api-types.ts"
  },
  "dependencies": {
    "cesium": "1.146.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satellite.js": "7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.5"
  }
}
