# Every Perigee setting, with its default. None of these are secrets.
PERIGEE_DATA_DIR=data
PERIGEE_USER_AGENT=Perigee/0.1 (orbital debris risk tracker; github.com/aryanpol73/perigee)
PERIGEE_GP_GROUPS=active,analyst,cosmos-2251-debris,iridium-33-debris,fengyun-1c-debris

# Minimum hours between downloads (CelesTrak policy: GP every 2 h at most).
PERIGEE_GP_MIN_INTERVAL_H=2
PERIGEE_SATCAT_MIN_INTERVAL_H=12
PERIGEE_SW_MIN_INTERVAL_H=24

PERIGEE_HTTP_TIMEOUT_S=60
PERIGEE_HTTP_MAX_ATTEMPTS=3

# Data quality thresholds.
PERIGEE_GP_MIN_OBJECTS=10000
PERIGEE_SATCAT_MIN_OBJECTS=50000
PERIGEE_SW_MIN_DAYS=1000
PERIGEE_MAX_COUNT_DROP=0.20
PERIGEE_MAX_BAD_ROW_FRACTION=0.01

# API: the published results bundle it serves (data/results/LATEST.json points at
# the newest), allowed browser origins, data age that makes /v1/health return 503,
# requests per minute per client IP.
PERIGEE_RESULTS_DIR=data/results
PERIGEE_API_CORS_ORIGINS=http://localhost:5173
PERIGEE_API_MAX_DATA_AGE_H=48
PERIGEE_API_RATE_LIMIT_PER_MIN=120
PERIGEE_API_SIMULATE_PER_MIN=10
# Public dataset of derived results the API downloads at startup (owner/name); empty = serve PERIGEE_RESULTS_DIR as is.
PERIGEE_RESULTS_REPO=
# Where `api` listens (the container sets 0.0.0.0 and PORT=7860; hosts may pass their own PORT).
PERIGEE_API_HOST=127.0.0.1
PORT=8000
# Proxies whose X-Forwarded-For uvicorn trusts for the client IP (the container sets *).
FORWARDED_ALLOW_IPS=127.0.0.1

# Error tracking. A Sentry DSN is not a secret (it only allows sending events), but keep it out of the repo anyway.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Scheduled jobs only (docs/data-job.md, docs/deployment.md). The tokens are secrets:
# set them in GitHub Secrets or your shell, never in a committed file.
# HF_TOKEN writes the private archive (raw snapshots, models). The site is published to
# Cloudflare Pages with CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID (GitHub secrets only).
PERIGEE_HF_DATASET=
HF_TOKEN=

# Web build (web/), baked in at build time. VITE_DATA_BASE (production: /data) makes the
# app read the static site's data files instead of an API; otherwise it uses the API at
# VITE_API_BASE (empty = the dev proxy). VITE_PYODIDE_BASE: where the browser simulator's
# Python runtime is served (default /pyodide/). VITE_SENTRY_DSN: optional error tracking.
VITE_DATA_BASE=
VITE_API_BASE=
VITE_PYODIDE_BASE=
VITE_SENTRY_DSN=
